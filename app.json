{
  "expo": {
    "name": "Cifrei",
    "slug": "cifrei",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-cifrei-adaptative.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo-cinza.png",
      "resizeMode": "contain",
      "backgroundColor": "#dd2c00"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.christian.cifrei"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-cifrei-adaptative.png",
        "backgroundColor": "#0139fe"
      },
      "package": "com.christian.cifrei"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "cifrei",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "18348dee-6eb7-43d0-983a-86d35236aa31"
      }
    }
  }
}
